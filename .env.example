# Database — Supabase PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Assignment timeout in seconds (2 minutes for demo)
ASSIGNMENT_TIMEOUT_SECONDS=120

# Firebase — path to your service account JSON
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
